# Directory containing individual student folders (each student's screenshots inside)
STUDENTS_ROOT=students

# Output Excel file path
OUTPUT_EXCEL=outputs/progress.xlsx

# State file to avoid duplicate processing
STATE_FILE=state/state.json

# Optional: Path to tesseract binary if not on PATH
# TESSERACT_CMD=/usr/bin/tesseract

# SMTP mail settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app_password_here
SMTP_FROM=you@example.com
SMTP_TO=recipient1@example.com,recipient2@example.com
EMAIL_SUBJECT_PREFIX=[Student OCR]
