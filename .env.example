# Path to the root folder containing all student folders
STUDENTS_ROOT=/workspace/students

# Output spreadsheet path
SPREADSHEET_PATH=/workspace/data/student_report.xlsx

# State file path to track processed screenshots
STATE_PATH=/workspace/data/state.json

# How often to run (hours)
RUN_EVERY_HOURS=2

# Tesseract binary path (if not in PATH)
# On Linux typically just "tesseract"
TESSERACT_CMD=tesseract

# Email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
# Set to true to attach spreadsheet to the email
EMAIL_ATTACH_SPREADSHEET=false
